+  /// A BIND(C) procedure has no hidden character length arguments. Passing
+  /// them anyway is harmless in native calling conventions, but on wasm the
+  /// caller's and the callee's signatures must match exactly.
+  bool dropsCharLen(mlir::Operation *op) {
+    return fir::hasBindcAttr(op) && fir::getTargetTriple(getModule()).isWasm();
+  }
+  template <typename A>
+  bool dropsCharLen(A callOp) {
+    if (dropsCharLen(callOp.getOperation()))
+      return true;
+    // Passes that rebuild a call may not carry its attributes over: the
+    // callee's declaration is authoritative for direct calls.
+    if constexpr (std::is_same_v<std::decay_t<A>, fir::CallOp>)
+      if (auto callee = callOp.getCallee())
+        if (auto *fn = getModule().lookupSymbol(*callee))
+          return dropsCharLen(fn);
+    return false;
+  }
