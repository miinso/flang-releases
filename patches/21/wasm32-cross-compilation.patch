+  void set_pointerByteSize(std::size_t bytes) {
+    pointerByteSize_ = bytes;
+    procedurePointerByteSize_ = bytes;
+    procedurePointerAlignment_ = bytes;
+    descriptorAlignment_ = bytes;
+  }
+  // Size in bytes of the runtime's descriptor (not the data) on the target:
+  // base_addr, elem_len, version and four byte-sized fields, then
+  // rank * {lower_bound, extent, sm}, then the optional addendum
+  // (derived type pointer padded to 8 bytes, int64 length parameters).
+  std::size_t descriptorByteSize(
+      int rank, bool addendum, int lengthTypeParameters) const {
+    std::size_t bytes{2 * pointerByteSize_ + 8 + rank * 3 * pointerByteSize_};
+    if (addendum || lengthTypeParameters > 0) {
+      bytes += 8 + 8 * static_cast<std::size_t>(
+                           lengthTypeParameters < 1 ? 1 : lengthTypeParameters);
+    }
+    return bytes;
+  }
