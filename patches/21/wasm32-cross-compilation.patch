+
+mlir::FunctionType fir::runtime::applyTargetWidths(fir::FirOpBuilder &builder,
+                                                   llvm::StringRef name,
+                                                   mlir::FunctionType funTy) {
+  struct Entry {
+    bool result;
+    std::uint64_t args;
+  };
+  static const llvm::StringMap<Entry> table = {
+#define TARGET_WIDTH_RT(NAME, RESULT, ARGS) {NAME, Entry{RESULT != 0, ARGS}},
+#include "flang/Optimizer/Builder/Runtime/TargetWidthRT.inc"
+#undef TARGET_WIDTH_RT
+  };
+  auto it = table.find(name);
+  if (it == table.end())
+    return funTy;
+  mlir::MLIRContext *ctx = builder.getContext();
+  mlir::Type widthTy = builder.getTargetSizeType();
+  llvm::SmallVector<mlir::Type> inputs(funTy.getInputs().begin(),
+                                       funTy.getInputs().end());
+  llvm::SmallVector<mlir::Type> results(funTy.getResults().begin(),
+                                        funTy.getResults().end());
+  for (unsigned i = 0; i < inputs.size() && i < 64; ++i)
+    if ((it->second.args >> i) & 1) {
+      assert(mlir::isa<mlir::IntegerType>(inputs[i]) &&
+             "target-width runtime argument must be an integer");
+      inputs[i] = widthTy;
+    }
+  if (it->second.result && results.size() == 1 &&
+      mlir::isa<mlir::IntegerType>(results[0]))
+    results[0] = widthTy;
+  return mlir::FunctionType::get(ctx, inputs, results);
+}
+
+mlir::StringAttr fir::FirOpBuilder::createCommonLinkage() {
+  if (fir::getTargetTriple(getModule()).isWasm())
+    return getStringAttr("weak");
+  return getStringAttr("common");
+}
