diff --git a/flang/lib/Frontend/CompilerInvocation.cpp b/flang/lib/Frontend/CompilerInvocation.cpp
index f55d866..8ab3402 100644
--- a/flang/lib/Frontend/CompilerInvocation.cpp
+++ b/flang/lib/Frontend/CompilerInvocation.cpp
@@ -1725,6 +1725,14 @@ void CompilerInvocation::setDefaultPredefinitions() {
     fortranOptions.predefinitions.emplace_back("__aarch64__", "1");
     fortranOptions.predefinitions.emplace_back("__aarch64", "1");
     break;
+  case llvm::Triple::ArchType::wasm32:
+    fortranOptions.predefinitions.emplace_back("__wasm__", "1");
+    fortranOptions.predefinitions.emplace_back("__wasm32__", "1");
+    break;
+  case llvm::Triple::ArchType::wasm64:
+    fortranOptions.predefinitions.emplace_back("__wasm__", "1");
+    fortranOptions.predefinitions.emplace_back("__wasm64__", "1");
+    break;
   }
 }
 
@@ -1759,6 +1767,14 @@ void CompilerInvocation::setFortranOpts() {
       preprocessorOptions.searchDirectoriesFromIntrModPath.begin(),
       preprocessorOptions.searchDirectoriesFromIntrModPath.end());
 
+  // The intrinsic modules built for a wasm target (C kinds and C pointer
+  // sizes differ from the host's) are in a directory named after its
+  // architecture; it is searched before the default one.
+  if (llvm::Triple targetTriple{llvm::Triple(this->targetOpts.triple)};
+      targetTriple.isWasm())
+    fortranOptions.intrinsicModuleDirectories.emplace_back(
+        getIntrinsicDir(getArgv0()) + targetTriple.getArchName().str() + "/");
+
   //  Add the default intrinsic module directory
   fortranOptions.intrinsicModuleDirectories.emplace_back(
       getIntrinsicDir(getArgv0()));
diff --git a/flang/module/__fortran_builtins.f90 b/flang/module/__fortran_builtins.f90
index 4d134fa..631536e 100644
--- a/flang/module/__fortran_builtins.f90
+++ b/flang/module/__fortran_builtins.f90
@@ -33,13 +33,19 @@ module __fortran_builtins
 
   intrinsic :: selected_int_kind
   integer, parameter :: int64 = selected_int_kind(18)
+#ifdef __wasm32__
+  ! 32-bit addresses: C pointers are 4 bytes
+  integer, parameter :: addrKind = selected_int_kind(9)
+#else
+  integer, parameter :: addrKind = int64
+#endif
 
   type, bind(c), public :: __builtin_c_ptr
-    integer(kind=int64), private :: __address
+    integer(kind=addrKind), private :: __address
   end type
 
   type, bind(c), public :: __builtin_c_funptr
-    integer(kind=int64), private :: __address
+    integer(kind=addrKind), private :: __address
   end type
 
   type, public :: __builtin_event_type
diff --git a/flang/module/__fortran_type_info.f90 b/flang/module/__fortran_type_info.f90
index 8dd27d6..e43c674 100644
--- a/flang/module/__fortran_type_info.f90
+++ b/flang/module/__fortran_type_info.f90
