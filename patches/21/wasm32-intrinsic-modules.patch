diff --git a/flang/module/iso_c_binding.f90 b/flang/module/iso_c_binding.f90
index 8e3f78c..7891321 100644
--- a/flang/module/iso_c_binding.f90
+++ b/flang/module/iso_c_binding.f90
@@ -43,10 +43,18 @@ module iso_c_binding
   integer, parameter, public :: &
     c_int = c_int32_t, &
     c_short = c_int16_t, &
+#ifdef __wasm32__
+    c_long = c_int32_t, &
+#else
     c_long = c_int64_t, &
+#endif
     c_long_long = c_int64_t, &
     c_signed_char = c_int8_t, &
+#ifdef __wasm32__
+    c_size_t = c_int32_t, &
+#else
     c_size_t = kind(c_sizeof(1)), &
+#endif
     ! Currently both gcc and clang define intmax_t to be 64 bit.
     c_intmax_t = c_int64_t, &
     c_intptr_t = c_size_t, &
@@ -57,6 +65,8 @@ module iso_c_binding
     c_int_least16_t = c_int16_t, &
 #if defined(__linux__) && defined(__powerpc__)
     c_int_fast16_t = c_long, &
+#elif defined(__wasm32__)
+    c_int_fast16_t = c_int32_t, &
 #else
     c_int_fast16_t = c_int16_t, &
 #endif
@@ -117,8 +127,12 @@ module iso_c_binding
     c_unsigned_char = c_uint8_t, &
     c_unsigned_short = c_uint16_t, &
     c_unsigned = c_uint32_t, &
+#ifdef __wasm32__
+    c_unsigned_long = c_uint32_t, &
+#else
     c_unsigned_long = c_uint64_t, &
-    c_unsigned_long_long = c_unsigned_long, &
+#endif
+    c_unsigned_long_long = c_uint64_t, &
 #if __powerpc__
     c_uintmax_t = c_uint64_t
 #else
